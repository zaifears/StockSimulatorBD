# Add to the scraper VPS Caddyfile. live.shahoriar.bd is a PROXIED (orange
# cloud) record on the shahoriar.bd Cloudflare zone; dse.shahoriar.bd stays
# DNS-only and unchanged.
live.shahoriar.bd {
	# Only the two public paths; everything else is 404.
	@public path /v1/snapshot.json /health
	handle @public {
		reverse_proxy 127.0.0.1:8010
	}
	handle {
		respond 404
	}
	encode zstd gzip
}
