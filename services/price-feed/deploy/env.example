# Copy to /home/ubuntu/price-feed/.env (chmod 600). Never commit the real file.

# Dedicated service account with roles/datastore.user (not the web app's key).
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/price-feed/service-account.json
# Optional: defaults to the project_id inside the key file.
# FIREBASE_PROJECT_ID=

APP_ID=stocksimulatorbd-dse-v1
BIND=127.0.0.1:8010

# Phase 2: fetch and compare only. No Firestore writes, no snapshot served,
# /health reports "dry-run" so /api/stock-sync keeps running as today.
DRY_RUN=1
COMPARE_URL=http://127.0.0.1:8005/api/market_sync

# Hard cap on Firestore writes per Dhaka day (set from Phase 0 numbers).
MAX_WRITES_PER_DAY=1500

# Alerts (optional). Same bot as the web app's admin alerts.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_TOPIC_ID=
# Uptime Kuma push monitor for this service (its own monitor, not the shared one).
# PRICE_FEED_KUMA_PUSH_URL=

RUST_LOG=info
