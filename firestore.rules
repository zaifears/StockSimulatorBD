rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== UTILITY FUNCTIONS =====
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Admin status comes from the signed custom claim only. The previous
    // `get(users/$(uid)).data.role == 'admin'` fallback made admin depend on
    // a mutable Firestore field (and cost a document read on every rule
    // evaluation that referenced it). A custom claim can only be set with
    // service-account credentials, so no client write can forge one.
    // .get('admin', false) rather than .admin — reading a claim that isn't
    // present throws ("Property admin is undefined on object"), and a rule
    // that throws is a rule that can't be reasoned about. Verified in the
    // emulator: every ordinary non-admin write was logging an evaluation
    // error here before this.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // ===== USERS COLLECTION =====
    match /users/{userId} {
      // Server-only fields: privilege flags, welcome-bonus dedup bookkeeping
      // (see app/api/auth/grant-social-bonus/route.ts), educational-use consent,
      // and Boss Pro subscription expiry. The client may never set, change,
      // or REMOVE any of these.
      function protectedUserFields() {
        return ['admin', 'welcomeBonusGranted', 'role', 'isGodMode', 'disclaimerAgreedAt', 'promoCodeRedeemedAt', 'tradeSurveyCompletedAt', 'bossUntil'];
      }

      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(protectedUserFields())
        && request.resource.data.get('accountTier', 'Bro') != 'Boss';

      // Judged on what actually CHANGED, not on what the finished document
      // happens to contain.
      //
      // This previously used `request.resource.data.keys().hasAny(...)` for
      // all writes. On an update, request.resource.data is the whole
      // post-write document — untouched fields included — so that condition
      // was true for every user who had a `coins` field, i.e. everyone. Net
      // effect, confirmed in the Firestore emulator: EVERY client update to
      // a user document was denied, silently breaking updateUserProfile().
      //
      // The same bug had a second face. A full-document setDoc() (no merge)
      // was ALLOWED, because the replacement document doesn't list the
      // protected keys — so a client could erase their own coins or wipe
      // their recorded consent. diff().affectedKeys() covers additions,
      // changes and removals, which closes both directions at once.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountTier']) || request.resource.data.get('accountTier', 'Bro') != 'Boss');

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['welcomeBonusGranted', 'lastCoinUpdate', 'lastCoinAction']);

      allow delete: if false;
    }
    
    // ===== PROMO CODES =====
    // Single-use codes redeemable for a trading-balance credit (see
    // app/api/simulator/promo-redeem/route.ts and
    // app/api/admin/promo-codes/route.ts). Both generation and redemption go
    // through those Admin SDK routes, which bypass these rules entirely — the
    // rule below only matters for denying any DIRECT client write, and for
    // letting the admin panel list codes without a server round-trip.
    // Regular (non-admin) users get no read access at all: nothing here lets
    // a client enumerate or peek at an unredeemed code.
    match /promo_codes/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===== SURVEY RESPONSES =====
    // Responses to the /trade domain & experience questionnaire.
    // Writes are server-only through app/api/survey/trade-questionnaire (Admin SDK).
    // Admins can read the collection directly or via API.
    match /survey_responses/{responseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===== COIN TRANSACTIONS =====
    match /coinTransactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // ===== RECHARGE REQUESTS =====
    match /recharge_requests/{requestId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && hasRequiredFields(['userId', 'amount', 'coins', 'transactionId', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 5000
        && request.resource.data.amount % 20 == 0
        // 🔒 Coins must match the fixed exchange rate (20 BDT = 10,000 coins).
        // The admin approval endpoint recomputes this from `amount` itself and
        // ignores whatever is stored here, but rejecting the write here stops
        // a forged request from ever landing in the pending queue an admin
        // has to review by eye.
        && request.resource.data.coins == (request.resource.data.amount / 20) * 10000;
      allow update, delete: if false;
    }
    
    // ===== BOSS UPGRADE REQUESTS =====
    match /boss_requests/{requestId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && hasRequiredFields(['userId', 'amount', 'planId', 'durationDays', 'transactionId', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount in [20, 99]
        && request.resource.data.durationDays in [31, 185];
      allow update, delete: if false;
    }
    
    // ===== SIMULATOR STATE =====
    match /artifacts/{appId}/users/{userId}/simulator/state {
      allow read: if isOwner(userId);

      // 🔒 Trade execution (app/api/simulator/trade) and brand-new-user
      // state creation (app/api/simulator/ensure-state) both moved
      // server-side and write via the Admin SDK, which bypasses these rules
      // entirely — so the client gets no write access here at all, not even
      // `create`.
      //
      // A `create`-only exception used to exist here for a client-side
      // "onSnapshot says doc not found -> setDoc the zero-value doc"
      // fallback in hooks/useSimulator.ts. That fallback could fire on a
      // stale/cached "not found" read that raced a real trade, and this
      // rule could not tell that apart from a genuinely brand-new user —
      // both are a `create` from the rules engine's point of view the
      // instant the fallback fires before the real doc's existence is
      // reflected locally. Several real accounts got their balance and
      // portfolio wiped to zero this way. The fallback and this exception
      // are both removed; ensure-state now does the same "create if
      // missing" job atomically inside one Admin SDK transaction, closing
      // the client-side race entirely rather than relying on rules to catch
      // it after the fact.
      allow create, update, delete: if false;
    }
    
// ===== TRADE HISTORY =====
    // 🔒 Trade execution (app/api/simulator/trade) writes these records via
    // the Admin SDK, which bypasses these rules entirely — the client never
    // needs to write here. The previous `allow create: if isOwner(userId)`
    // let any authenticated user forge arbitrary trade records (fake
    // symbol/price/quantity/type) directly through the client SDK, with no
    // validation at all; closing it off the same way simulator/state was.
    match /artifacts/{appId}/users/{userId}/trade_history/{tradeId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // trade_history nested under simulator/state (the path the trade route
    // actually writes to — see app/api/simulator/trade/route.ts)
    match /artifacts/{appId}/users/{userId}/simulator/state/trade_history/{tradeId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }
    
    // ===== MARKET DATA (read-only) =====
    match /artifacts/{appId}/public/data/market_info/latest {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    match /artifacts/{appId}/public/data/market_info/categories {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/market_info/sectors {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/market_info/sectors/changelog/{entryId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ===== PUBLIC STATS =====
    match /public_stats/site_stats {
  		allow read: if true;
  		allow update: if isAuthenticated()
    		&& request.resource.data.diff(resource.data).affectedKeys()
        		.hasOnly(['userCount', 'lastUpdated']);
		}
    
    match /public_stats/site_stats/counted_users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if false;
    }
    
    // ===== SERVER-ONLY COLLECTIONS =====
    match /rate_limits/{identifier} {
      allow read, write, delete: if false;
    }
    
    match /_health/test {
      allow read, write, delete: if false;
    }
    
    // ===== SHORT LINKS =====
    match /short_links/{code} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.creatorId);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
        && request.resource.data.clicks == resource.data.clicks + 1;
    }
    
    // ===== DENY ALL OTHER PATHS =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}